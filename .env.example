# Copy this to .env and fill your values
WEATHER_API_KEY=
PORCUPINE_ACCESS_KEY=
DISTANCEMATRIX_API_KEY=
GEOCODING_API_KEY=
GROQ_API_KEY=
NEWS_API_KEY=
REMOTE_API_KEY=
REMOTE_SERVER_URL=http://127.0.0.1:8801
MEMORY_EMBEDDINGS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
WEBHOOK_SECRET=

# Optional (testing/mocks)
DISTANCEMATRIX_BASE=
GEOCODE_BASE=
WEATHER_BASE=

# --- FRIDAY browser control (Chrome) ---
# NVIDIA NIM is the primary LLM provider (Groq is fallback).
NVIDIA_API_KEY=
# Require the user's REAL Chrome (no fake fresh-Chromium fallback). 1 = on.
FRIDAY_REQUIRE_REAL_CHROME=0
# Which Chrome profile FRIDAY should operate (display name OR directory).
# Leave blank and run: python scripts/select_chrome_profile.py
# Per-device; never hardcoded. Also stored in ~/.friday/config.json.
FRIDAY_CHROME_PROFILE=
# Override Chrome's User Data dir if installed in a non-standard location.
FRIDAY_CHROME_USER_DATA_DIR=
# Search engine for web search (duckduckgo|google|bing). Default duckduckgo
# avoids Google's automated-traffic captcha wall.
FRIDAY_SEARCH_ENGINE=duckduckgo
# CDP debug port for connecting to Chrome.
CHROME_REMOTE_DEBUG_PORT=9222

# Safety: set to 1 to prevent all real external actions (Chrome opens, app
# launches, keyboard actions). Useful during development/testing so stale
# processes don't open phantom browsers. Only LLM generation is allowed.
FRIDAY_DRY_RUN=0
