{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "Electron shell for Jarvis voice assistant",
  "author": "Shreesh",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint renderer --ext .js,.jsx",
    "build": "cross-env NODE_ENV=production electron-builder --dir",
    "dist": "cross-env NODE_ENV=production electron-builder"
  },
  "dependencies": {
    "electron": "^38.2.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron-builder": "^24.6.4",
    "eslint": "^8.56.0"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "Jarvis Desktop",
    "files": [
      "main.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "../ui",
        "to": "resources/ui"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Jarvis-Desktop-Setup-${version}.exe"
    }
  }
}
